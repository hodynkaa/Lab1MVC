@model TicketApp.Models.Category

@{
    ViewData["Title"] = "Dodaj kategorię";
}

<h1>Dodaj nową kategorię</h1>

<div class="row mt-4">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label fw-bold">Nazwa kategorii</label>
                <input asp-for="Name" class="form-control" placeholder="np. Koncert" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Zapisz" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Wróć do listy</a>
            </div>
        </form>
    </div>
</div>