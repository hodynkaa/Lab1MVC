@model IEnumerable<TicketApp.Models.Category>

@{
    ViewData["Title"] = "Kategorie";
}

<h1>Kategorie wydarzeń</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj nową kategorię</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nazwa kategorii</th>
            <th class="text-end">Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td class="align-middle">@item.Name</td>
                <td class="text-end">
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Usuń</a>
                </td>
            </tr>
        }
    </tbody>
</table>