@model TicketApp.Models.Event

@{
    ViewData["Title"] = "Dodaj wydarzenie";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">Utwórz nowe wydarzenie</h2>
        <a asp-action="Index" class="btn btn-outline-primary px-4">
            Wróć do listy
        </a>
    </div>

    <div class="card border-1 shadow-sm rounded-3">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <div class="row">
                    <div class="col-md-6 pe-md-4">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">Podstawowe informacje</h5>

                        <div class="form-group mb-3">
                            <label asp-for="Title" class="form-label fw-semibold text-muted">Tytuł wydarzenia</label>
                            <input asp-for="Title" class="form-control form-control-lg bg-light border-0" />
                            <span asp-validation-for="Title" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold text-muted">Kategoria</label>
                            <select asp-for="CategoryId" class="form-select form-select-lg bg-light border-0" asp-items="ViewBag.CategoryId">
                                <option value="">-- Wybierz kategorię --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger ma ma-bold"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="EventDate" class="form-label fw-semibold text-muted">Data i godzina</label>
                            <input asp-for="EventDate" class="form-control bg-light border-0" type="datetime-local" />
                            <span asp-validation-for="EventDate" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Location" class="form-label fw-semibold text-muted">Miejsce wydarzenia</label>
                            <input asp-for="Location" class="form-control bg-light border-0"  />
                            <span asp-validation-for="Location" class="text-danger ma-bold"></span>
                        </div>
                    </div>

                    <div class="col-md-6 ps-md-4 mt-4 mt-md-0 border-start-md">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">Bilety i miejsca</h5>

                        <div class="form-group mb-3">
                            <label asp-for="TicketPrice" class="form-label fw-semibold text-muted">Cena biletu (PLN)</label>
                            <div class="input-group">
                                <input asp-for="TicketPrice" class="form-control form-control-lg text-success fw-bold bg-light border-0" type="number" step="0.01" placeholder="0.00" />
                                <span class="input-group-text bg-light border-0 text-muted">PLN</span>
                            </div>
                            <span asp-validation-for="TicketPrice" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="row">
                            <div class="col-6">
                                <div class="form-group mb-3">
                                    <label asp-for="TotalSeats" class="form-label fw-semibold text-muted">Wszystkie miejsca</label>
                                    <input asp-for="TotalSeats" class="form-control bg-light border-0" type="number" />
                                    <span asp-validation-for="TotalSeats" class="text-danger small fw-bold"></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group mb-3">
                                    <label asp-for="AvailableSeats" class="form-label fw-semibold text-muted">Dostępne miejsca</label>
                                    <input asp-for="AvailableSeats" class="form-control bg-light border-0" type="number" />
                                    <span asp-validation-for="AvailableSeats" class="text-danger small fw-bold"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-semibold text-muted">Opis wydarzenia</label>
                            <textarea asp-for="Description" class="form-control bg-light border-0" rows="4" placeholder="Napisz kilka słów o tym wydarzeniu..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small fw-bold"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-2 pt-3 border-top">
                    <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm fw-bold">
                        Dodaj wydarzenie
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}