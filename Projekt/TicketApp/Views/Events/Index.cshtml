@model IEnumerable<TicketApp.Models.Event>

@{
    ViewData["Title"] = "Panel Administratora";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Panel Administratora 🛠️</h2>
        <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
            <i class="bi bi-plus-circle me-2"></i> Dodaj nowe wydarzenie
        </a>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 10px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted">
                        <tr>
                            <th class="ps-4">Data i Czas</th>
                            <th>Tytuł wydarzenia</th>
                            <th>Kategoria</th>
                            <th>Cena</th>
                            <th class="text-center">Miejsca (Wolne / Wszystkie)</th>
                            <th class="text-end pe-4">Zarządzaj</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    Brak wydarzeń w bazie. Dodaj pierwsze!
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom">
                                    <td class="ps-4 text-muted small fw-bold">
                                        @item.EventDate.ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                    <td class="fw-bold text-dark">
                                        @item.Title
                                    </td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-75">@item.Category?.Name</span>
                                    </td>
                                    <td class="text-success fw-bold">
                                        @item.TicketPrice.ToString("C")
                                    </td>
                                    <td class="text-center">
                                        @if(item.AvailableSeats < 10) {
                                            <span class="text-danger fw-bold">@item.AvailableSeats</span>
                                        } else {
                                            <span class="text-dark fw-bold">@item.AvailableSeats</span>
                                        }
                                        <span class="text-muted">/ @item.TotalSeats</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                            Edytuj
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                            Usuń
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>