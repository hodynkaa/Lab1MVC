@model TicketApp.Models.Event

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                
                <div class="card-header bg-dark text-white p-4 p-md-5">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                        <div>
                            <span class="badge bg-primary bg-opacity-75 fs-6 mb-2">@Model.Category?.Name</span>
                            <h1 class="display-5 fw-bold mb-0">@Model.Title</h1>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="row">
                        <div class="col-md-7 col-lg-8 pe-md-4">
                            <h4 class="fw-bold mb-3 border-bottom pb-2">O wydarzeniu</h4>
                            <p class="text-justify text-muted mb-4" style="font-size: 1.1rem; line-height: 1.6;">
                                @Model.Description
                            </p>
                            
                            <div class="row bg-light p-3 rounded-3 mt-4">
                                <div class="col-sm-6 mb-3 mb-sm-0">
                                    <p class="text-muted small fw-bold text-uppercase mb-1"><i class="bi bi-calendar-event me-2"></i>Data i godzina</p>
                                    <h6 class="fw-bold mb-0">@Model.EventDate.ToString("dd.MM.yyyy HH:mm")</h6>
                                </div>
                                <div class="col-sm-6">
                                    <p class="text-muted small fw-bold text-uppercase mb-1"><i class="bi bi-geo-alt me-2"></i>Miejsce</p>
                                    <h6 class="fw-bold mb-0">@Model.Location</h6>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5 col-lg-4 mt-5 mt-md-0">
                            <div class="p-4 bg-light rounded-3 text-center border">
                                <p class="text-muted fw-bold text-uppercase mb-1">Cena biletu</p>
                                <h2 class="display-6 text-success fw-bold mb-3">@Model.TicketPrice.ToString("C")</h2>
                                
                                <div class="d-flex justify-content-center align-items-center mb-4">
                                    <span class="badge @(Model.AvailableSeats > 10 ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                                        Dostępne miejsca: @Model.AvailableSeats
                                    </span>
                                </div>

                                @if (!User.Identity!.IsAuthenticated)
                                {
                                    <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-warning btn-lg w-100 fw-bold shadow-sm">
                                        <i class="bi bi-person-circle me-2"></i> Zaloguj się, aby kupić
                                    </a>
                                }
                                else if (Model.AvailableSeats > 0)
                                {
                                    <div class="alert alert-warning py-2 mb-3 small text-start">
                                        <i class="bi bi-info-circle me-1"></i> Klikając przycisk poniżej, potwierdzasz zakup biletu.
                                    </div>
                                    <form asp-action="ConfirmPurchase" asp-route-id="@Model.Id" method="post">
                                        <button type="submit" class="btn btn-success btn-lg w-100 py-3 shadow-sm fw-bold">
                                            <i class="bi bi-cart-check me-2"></i> Potwierdzam płatność
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-lg w-100 disabled fw-bold">
                                        <i class="bi bi-x-circle me-2"></i> Brak biletów
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card-footer bg-white p-4 text-center text-md-start border-top-0">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">
                        <i class="bi bi-arrow-left me-2"></i> Wróć do strony głównej
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>