@model TicketApp.Models.Event

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white p-4">
            <h1 class="display-4">@Model.Title</h1>
            <p class="lead mb-0">@Model.Category?.Name</p>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-8">
                    <h3>O wydarzeniu</h3>
                    <p class="text-justify" style="font-size: 1.1rem;">@Model.Description</p>
                    <hr />
                    <div class="d-flex justify-content-start gap-4">
                        <div>
                            <p class="text-muted mb-0">Data и Godzina</p>
                            <h5>@Model.EventDate.ToString("f")</h5>
                        </div>
                        <div>
                            <p class="text-muted mb-0">Miejsce</p>
                            <h5>@Model.Location</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 border-start">
                    <div class="p-3 bg-light rounded text-center">
                        <p class="text-muted">Cena biletu</p>
                        <h2 class="display-5 text-success fw-bold">@Model.TicketPrice.ToString("C")</h2>
                        <p class="text-muted small">Dostępne miejsca: @Model.AvailableSeats</p>

                        @if (!User.Identity.IsAuthenticated)
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-warning btn-lg w-100">
                                Zaloguj się, aby kupić
                            </a>
                        }
                        else if (Model.AvailableSeats > 0)
                        {
                            <div class="alert alert-warning py-2 mt-3 small">
                                Klikając przycisk poniżej, potwierdzasz zakup biletu.
                            </div>
                            <form asp-action="ConfirmPurchase" asp-route-id="@Model.Id" method="post">
                                <button type="submit" class="btn btn-success btn-lg w-100 py-3 shadow-sm">
                                    Potwierdzam płatność
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-lg w-100 disabled">Brak biletów</button>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white p-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Wróć do strony głównej</a>
        </div>
    </div>
</div>