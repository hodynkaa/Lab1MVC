@model TicketApp.Models.Event

@{
    ViewData["Title"] = "Edytuj wydarzenie";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Edytuj wydarzenie</h2>
            <p class="text-muted mb-0">Wprowadź zmiany dla: <span class="fw-bold text-primary">@Model.Title</span></p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">
            <i class="bi bi-arrow-left me-2"></i> Wróć do listy
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 pe-md-4">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">Podstawowe informacje</h5>

                        <div class="form-group mb-3">
                            <label asp-for="Title" class="form-label fw-semibold text-muted">Tytuł wydarzenia</label>
                            <input asp-for="Title" class="form-control form-control-lg bg-light border-0 shadow-none" />
                            <span asp-validation-for="Title" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold text-muted">Kategoria</label>
                            <select asp-for="CategoryId" class="form-select form-select-lg bg-light border-0 shadow-none" asp-items="ViewBag.CategoryId"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="EventDate" class="form-label fw-semibold text-muted">Data i godzina</label>
                            <input asp-for="EventDate" class="form-control bg-light border-0 shadow-none" />
                            <span asp-validation-for="EventDate" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Location" class="form-label fw-semibold text-muted">Miejsce wydarzenia</label>
                            <input asp-for="Location" class="form-control bg-light border-0 shadow-none" />
                            <span asp-validation-for="Location" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="col-md-6 ps-md-4 mt-4 mt-md-0 border-start-md">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">Bilety i miejsca</h5>

                        <div class="form-group mb-3">
                            <label asp-for="TicketPrice" class="form-label fw-semibold text-muted">Cena biletu (PLN)</label>
                            <div class="input-group">
                                <input asp-for="TicketPrice" class="form-control form-control-lg text-primary fw-bold bg-light border-0 shadow-none" type="number" step="0.01" />
                                <span class="input-group-text bg-light border-0 text-muted">PLN</span>
                            </div>
                            <span asp-validation-for="TicketPrice" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>

                        <div class="row">
                            <div class="col-6">
                                <div class="form-group mb-3">
                                    <label asp-for="TotalSeats" class="form-label fw-semibold text-muted">Wszystkie miejsca</label>
                                    <input asp-for="TotalSeats" class="form-control bg-light border-0 shadow-none" type="number" />
                                    <span asp-validation-for="TotalSeats" class="text-danger ma-bold mt-1 d-block"></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group mb-3">
                                    <label asp-for="AvailableSeats" class="form-label fw-semibold text-muted">Dostępne miejsca</label>
                                    <input asp-for="AvailableSeats" class="form-control bg-light border-0 shadow-none fw-bold @(Model.AvailableSeats < 10 ? "text-danger" : "text-success")" type="number" />
                                    <span asp-validation-for="AvailableSeats" class="text-danger small fw-bold mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-semibold text-muted">Opis wydarzenia</label>
                            <textarea asp-for="Description" class="form-control bg-light border-0 shadow-none" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-2 pt-4 border-top">
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm fw-bold">
                        <i class="bi bi-save me-2"></i> Zapisz zmiany
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}