@model ErrorViewModel
@{
    ViewData["Title"] = "Wystąpił błąd";
}

<div class="container mt-5 mb-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden mt-5">
                <div class="card-body p-5">
                    
                    <i class="bi bi-exclamation-triangle text-warning mb-3" style="font-size: 5rem;"></i>
                    
                    <h2 class="fw-bold text-dark mt-2">Ups! Coś poszło nie tak.</h2>
                    <p class="text-muted fs-5 mb-4 text-center">
                        Przepraszamy, podczas przetwarzania Twojego żądania wystąpił nieoczekiwany błąd serwera. Nasi specjaliści już o tym wiedzą!
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-light border text-start small mb-4" role="alert">
                            <strong class="text-dark"><i class="bi bi-bug me-1"></i> ID błędu (Request ID):</strong> 
                            <code class="fs-6 ms-1">@Model.RequestId</code>
                            <hr class="my-2">
                            <span class="text-muted small">Jeśli problem będzie się powtarzał, podaj ten kod kontaktując się z pomocą techniczną.</span>
                        </div>
                    }

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-3 fw-bold shadow-sm">
                            <i class="bi bi-house-door me-2"></i> Wróć na stronę główną
                        </a>
                    </div>
                    
                </div>
            </div>
            
        </div>
    </div>
</div>