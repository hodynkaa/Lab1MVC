@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-dark fw-bold d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle fs-4 me-2 text-primary"></i> 
            <span>Witaj, @(User.Identity?.Name?.Split('@')[0])!</span>
        </a>
        
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userDropdown">
            
            <li class="px-3 py-2 text-center bg-light mb-1">
                <strong class="d-block text-primary text-uppercase" style="font-size: 0.9rem;">Konto Użytkownika</strong>
                <small class="text-muted">@User.Identity?.Name</small>
            </li>
            
            <li><hr class="dropdown-divider"></li>

            <li>
                <a class="dropdown-item py-2 fw-semibold" asp-area="" asp-controller="Profile" asp-action="Index">
                    <i class="bi bi-person-gear me-2 text-secondary"></i> Mój profil
                </a>
            </li>

            <li>
                <a class="dropdown-item py-2 fw-semibold" asp-controller="Reservations" asp-action="Index">
                    <i class="bi bi-ticket-perforated me-2 text-secondary"></i> Moje bilety
                </a>
            </li>

            <li><hr class="dropdown-divider"></li>

            <li>
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item py-2 text-danger fw-bold">
                        <i class="bi bi-box-arrow-right me-2"></i> Wyloguj się
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="btn btn-outline-primary fw-bold px-3 shadow-sm" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Zaloguj się
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary fw-bold px-3 shadow-sm" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus me-1"></i> Rejestracja
        </a>
    </li>
}
</ul>