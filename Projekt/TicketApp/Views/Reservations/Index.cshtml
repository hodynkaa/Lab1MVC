@model IEnumerable<TicketApp.Models.Reservation>

<div class="container mt-5 mb-5">
    <h2 class="mb-4 text-dark fw-bold">Moje bilety</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5 shadow-sm border-0" style="border-radius: 15px;">
            <h4 class="mb-3">Nie masz jeszcze żadnych biletów.</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">Znajdź wydarzenie</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var group in Model.GroupBy(r => r.EventId))
            {
                var firstTicket = group.First(); // Берем первый билет, чтобы достать инфу о концерте
                var ev = firstTicket.Event;

                <div class="card shadow-sm border-0" style="border-radius: 8px; overflow: hidden;">
                    
                    <div class="card-header bg-light border-bottom p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold me-2">Order id:</span> @firstTicket.Id 
                            <span class="ms-4 fw-bold me-2">Purchased:</span> @firstTicket.ReservationDate.ToString("dd.MM.yyyy")
                        </div>
                        <span class="badge bg-success">Zakupiono pomyślnie</span>
                    </div>

                    <div class="card-body p-0">
                        <div class="row g-0">
                            
                            <div class="col-md-2 bg-dark d-flex align-items-center justify-content-center text-white p-4">
                                <div class="text-center">
                                    <i class="bi bi-ticket-perforated" style="font-size: 3rem;"></i>
                                    <div class="mt-2 fw-bold">@ev?.EventDate.ToString("MMM").ToUpper()</div>
                                    <div class="fs-4 fw-bold">@ev?.EventDate.ToString("dd")</div>
                                </div>
                            </div>

                            <div class="col-md-10 p-4">
                                
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h4 class="fw-bold mb-0">@ev?.Title</h4>
                                    <a asp-controller="Events" asp-action="Details" asp-route-id="@ev?.Id" class="btn btn-outline-primary btn-sm px-3">
                                        Szczegóły
                                    </a>
                                </div>
                                
                                <p class="text-muted mb-1">@ev?.EventDate.ToString("dd.MM.yyyy HH:mm")</p>
                                <p class="text-muted mb-4">@ev?.Location</p>

                                <table class="table table-borderless table-hover align-middle mb-0" style="background-color: #f8f9fa; border-radius: 5px;">
                                    <thead class="border-bottom">
                                        <tr>
                                            <th class="text-muted pb-2">Ticket No#</th>
                                            <th class="text-muted pb-2">Ticket type</th>
                                            <th class="text-end text-muted pb-2">Download</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ticket in group)
                                        {
                                            <tr class="border-bottom">
                                                <td class="fw-bold py-3">@ticket.Id.ToString().PadLeft(7, '0')</td>
                                                <td class="py-3">General admission</td>
                                                <td class="text-end py-3">
                                                    <button class="btn text-primary fw-bold text-decoration-none p-0" 
                                                            type="button" 
                                                            data-bs-toggle="collapse" 
                                                            data-bs-target="#qr-@ticket.Id">
                                                        QR | Pass
                                                    </button>
                                                </td>
                                            </tr>
                                            <tr class="p-0">
                                                <td colspan="3" class="p-0 border-0">
                                                    <div class="collapse" id="qr-@ticket.Id">
                                                        <div class="text-center p-3 bg-white border-top border-bottom mb-2 shadow-sm">
                                                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=TicketID:@ticket.Id" 
                                                                 alt="QR Code" 
                                                                 class="img-fluid rounded" />
                                                            <div class="mt-2 text-muted small fw-bold">Ticket: #@ticket.Id.ToString().PadLeft(7, '0')</div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>