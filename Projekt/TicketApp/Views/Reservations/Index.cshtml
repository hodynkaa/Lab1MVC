@model IEnumerable<TicketApp.Models.Reservation>

<div class="container mt-5">
    <h2 class="mb-4">Moje bilety</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5 shadow-sm">
            <h4 class="mb-3">Nie masz jeszcze żadnych biletów.</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">Znajdź wydarzenie</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 border-start border-5 border-success">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-success">Zakupiono pomyślnie</span>
                                <small class="text-muted">Data zakupu: @item.ReservationDate.ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                            <h4 class="card-title fw-bold">@item.Event?.Title</h4>
                            
                            <hr />
                            
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <i class="bi bi-calendar-event text-primary me-2"></i> 
                                    <strong>Data wydarzenia:</strong> @item.Event?.EventDate.ToString("f")
                                </li>
                                <li>
                                    <i class="bi bi-geo-alt text-danger me-2"></i> 
                                    <strong>Miejsce:</strong> @item.Event?.Location
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center p-3">
                            <span class="text-muted small">ID Rezerwacji: #@item.Id</span>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@item.EventId" class="btn btn-outline-secondary btn-sm">Szczegóły wydarzenia</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>